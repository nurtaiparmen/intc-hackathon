# Скопируйте этот файл в .env и заполните.

# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Модели. Список актуальных: https://ai.google.dev/gemini-api/docs/models
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# low — быстрее и дешевле. Для моделей Gemini 2.5 оставьте пустым.
GEMINI_THINKING_LEVEL=low

# Колледж
COLLEGE_NAME=Наш колледж
# Любой день первой учебной недели и её тип: numerator или denominator
SEMESTER_START=2026-09-01
FIRST_WEEK_TYPE=numerator
TIME_ZONE=Asia/Almaty

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=замените-на-случайную-строку
