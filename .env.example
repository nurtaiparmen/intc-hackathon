# Скопируйте этот файл в .env и заполните.

# ИИ-агент: любой OpenAI-совместимый API.
# По умолчанию Groq — бесплатный ключ без карты: https://console.groq.com/keys
# Без ключа сайт работает, а агент отвечает в простом режиме по ключевым словам.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Запасные модели через запятую: на них уходит запрос, если основная перегружена
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3-32b,llama-3.1-8b-instant

# Локально, без интернета, через Ollama (https://ollama.com, затем: ollama pull qwen3:8b):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# LLM_FALLBACK_MODELS=

# Колледж
COLLEGE_NAME=Наш колледж
# Любой день первой учебной недели и её тип: numerator или denominator
SEMESTER_START=2026-09-01
FIRST_WEEK_TYPE=numerator
TIME_ZONE=Asia/Almaty

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=замените-на-случайную-строку
