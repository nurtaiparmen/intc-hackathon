# Скопируйте этот файл в .env и заполните.

# ИИ: Google Gemini — бесплатный ключ без карты: https://aistudio.google.com/apikey
# Gemini и отвечает в чате, и читает фото расписания.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Запасные модели через запятую: на них уходит запрос, если основная перегружена
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest

# Вместо Gemini можно Groq (бесплатно, но без чтения фото):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=ключ_groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_MODELS=openai/gpt-oss-120b
# LLM_VISION=0

# Колледж
COLLEGE_NAME=Инновационный Технический Колледж
# Любой день первой учебной недели и её тип: numerator (левая) или denominator (правая)
SEMESTER_START=2026-09-01
FIRST_WEEK_TYPE=numerator
TIME_ZONE=Asia/Almaty

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=замените-на-случайную-строку
# На PythonAnywhere:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=логин.pythonanywhere.com
# DJANGO_CSRF_TRUSTED=https://логин.pythonanywhere.com
